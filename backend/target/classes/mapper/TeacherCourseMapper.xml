<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.school.scheduling.mapper.TeacherCourseMapper">
    <select id="findCourseIdsByTeacherId" resultType="java.lang.Long">
        SELECT course_id FROM teacher_course WHERE teacher_id = #{teacherId}
    </select>

    <select id="findTeacherIdsByCourseId" resultType="java.lang.Long">
        SELECT teacher_id FROM teacher_course WHERE course_id = #{courseId}
    </select>

    <insert id="insert">
        INSERT INTO teacher_course (teacher_id, course_id) VALUES (#{teacherId}, #{courseId})
    </insert>

    <delete id="delete">
        DELETE FROM teacher_course WHERE teacher_id = #{teacherId} AND course_id = #{courseId}
    </delete>

    <delete id="deleteByTeacherId">
        DELETE FROM teacher_course WHERE teacher_id = #{teacherId}
    </delete>
</mapper>
